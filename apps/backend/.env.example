NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://vocelune:vocelune_local@localhost:55432/vocelune?schema=public
APP_ORIGIN=http://localhost:3000
SESSION_DAYS=30
REDIS_URL=redis://localhost:56379
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=Vocelune <noreply@vocelune.local>
# SMTP_USER=
# SMTP_PASSWORD=
DICTIONARY_LICENSE_MODE=LIVE_ONLY
# OXFORD_APP_ID=
# OXFORD_APP_KEY=
# Only enable after verifying the contract allows persistence of returned fields.
# OXFORD_PERSISTENCE_APPROVED=false
# R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=vocelune-private
# Optional explicit local demo account, created ONLY by npm run db:seed:
# SEED_EMAIL=learner@example.test
# SEED_PASSWORD=Choose-a-long-local-password

# Generate with: openssl rand -hex 32 (required for encrypted password-reset emails)
# EMAIL_ENCRYPTION_KEY=
# For PERSIST_LICENSED only, specify exactly which fields the contract allows storing:
# OXFORD_PERSIST_FIELDS=definitionEn,exampleEn,phonetic
# Export rights are NOT implied; vendor fields are redacted from exports.

# Dictionary selection: tier 1 = Free Dictionary API (no key);
# tier 2 = Merriam-Webster Learner's / Oxford (server-side keys).
# Each user chooses their default source and explicitly enables free fallback in Settings.
# MERRIAM_WEBSTER_API_KEY=
MERRIAM_WEBSTER_DAILY_LIMIT=1000
# Only enable after confirming rights to persist fields for this application:
# MERRIAM_WEBSTER_PERSISTENCE_APPROVED=false
# MERRIAM_WEBSTER_PERSIST_FIELDS=definitionEn,exampleEn,phonetic
# Use sandbox for Oxford trial credentials; production for paid credentials:
OXFORD_ENVIRONMENT=production
