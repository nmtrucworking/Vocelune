{
  "name": "vocelune-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@vocelune/frontend",
    "dev:frontend": "npm run dev --workspace=@vocelune/frontend",
    "dev:backend": "echo 'Backend not initialized yet. Ready in apps/backend.'",
    "build": "npm run build --workspace=@vocelune/frontend",
    "build:frontend": "npm run build --workspace=@vocelune/frontend",
    "start": "npm run start --workspace=@vocelune/frontend",
    "lint": "npm run lint --workspace=@vocelune/frontend"
  }
}
