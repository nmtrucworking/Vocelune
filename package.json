{
  "name": "vocelune-workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace=@vocelune/frontend",
    "dev:backend": "npm run dev --workspace=@vocelune/backend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "npm run build --workspace=@vocelune/frontend",
    "start": "npm run start --workspace=@vocelune/frontend",
    "lint": "npm run typecheck",
    "setup": "node scripts/setup.mjs",
    "worker": "npm run worker --workspace=@vocelune/backend",
    "build:backend": "npm run build --workspace=@vocelune/backend",
    "start:backend": "npm run start --workspace=@vocelune/backend",
    "start:backend:prod": "npm run start:prod --workspace=@vocelune/backend",
    "typecheck": "npm run typecheck --workspace=@vocelune/backend && tsc --noEmit -p apps/frontend/tsconfig.json",
    "test": "npm run test --workspace=@vocelune/backend",
    "db:generate": "npm run db:generate --workspace=@vocelune/backend",
    "db:migrate": "npm run db:migrate --workspace=@vocelune/backend",
    "db:seed": "npm run db:seed --workspace=@vocelune/backend",
    "smoke:worker": "node scripts/smoke-worker.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "postcss": "8.5.32",
    "multer": "2.5.0",
    "js-yaml": "5.5.0",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2",
      "effect": "^3.20.0"
    }
  }
}
